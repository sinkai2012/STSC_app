<Page x:Class="STSC_app.News"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:STSC_app"
      Title="News">

    <Page.Resources>
        <local:KindsToColorConverter x:Key="KindsToColorConverter"/>

        <!-- 1. タグ複数選択用 DataTemplate -->
        <DataTemplate x:Key="TagCheckBoxTemplate">
            <CheckBox Content="{Binding Name}" 
                      IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                      Click="TagCheckBox_Click"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      Padding="6,0,0,0"
                      Margin="4,2"/>
        </DataTemplate>

        <!-- 2. ComboBoxItem のテーマ連動スタイル -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                Padding="6,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. ComboBox 本体のスタイル -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot" 
                                                Background="{DynamicResource CardBackgroundBrush}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="3">
                                            <Border x:Name="splitBorder" 
                                                    HorizontalAlignment="Right" 
                                                    Width="20">
                                                <Path x:Name="arrow" 
                                                      Data="M0,0 L4,4 L8,0 Z" 
                                                      Fill="{DynamicResource SecondaryTextBrush}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentTemplate" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,3,25,3" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" 
                                        Background="{DynamicResource CardBackgroundBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. TextBox スタイル -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 5. Button スタイル -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- ページ背景 -->
    <Grid Margin="10" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="266" MaxWidth="500"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側サイドバー -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Margin="0,0,5,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <!-- ニュース更新ボタン -->
                    <Button Height="30" Margin="0,0,0,8" Click="LoadButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ニュース更新" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ★ 並び替え ComboBox (ニュース更新ボタンの下に配置) -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="並び替え" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="SortOrderComboBox" 
                                  Height="26" 
                                  ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" 
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="公開日：新しい順 (降順)" IsSelected="True"/>
                            <ComboBoxItem Content="公開日：古い順 (昇順)"/>
                        </ComboBox>
                    </Grid>

                    <!-- Expander -->
                    <Expander IsExpanded="False" 
                              Background="{DynamicResource CardBackgroundBrush}" 
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Padding="6" 
                              Margin="0,0,0,5">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="13" 
                                           Margin="0,0,6,0" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="検索・フィルター条件" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Expander.Header>

                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="タイトル / タグ検索" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                            <TextBox x:Name="SearchKeywordTextBox" Height="24" Margin="0,0,0,6" TextChanged="Filter_Changed" Cursor="IBeam"/>

                            <TextBlock Text="種類" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                            <ComboBox x:Name="KindsFilterComboBox" 
                                      Height="24" 
                                      Margin="0,0,0,6" 
                                      ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" 
                                      SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="すべて" IsSelected="True"/>
                                <ComboBoxItem Content="通常"/>
                                <ComboBoxItem Content="警告"/>
                                <ComboBoxItem Content="重要"/>
                            </ComboBox>

                            <TextBlock Text="タグ（複数選択可）" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,6">
                                <ComboBox x:Name="TagFilterComboBox" 
                                          Height="24" 
                                          Background="{DynamicResource CardBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          ItemTemplate="{StaticResource TagCheckBoxTemplate}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItemStyle}">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>

                                <Border Background="{DynamicResource CardBackgroundBrush}" 
                                        Margin="1,1,20,1" 
                                        IsHitTestVisible="False">
                                    <TextBlock x:Name="TagFilterDisplayTextBlock" 
                                               Text="すべて（未選択）" 
                                               VerticalAlignment="Center" 
                                               Margin="6,0,0,0" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource PrimaryTextBrush}" 
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="投稿期間" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="StartDatePicker" Grid.Column="0" Height="24" SelectedDateChanged="Filter_Changed"/>
                                <TextBlock Grid.Column="1" Text="〜" VerticalAlignment="Center" Margin="3,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <DatePicker x:Name="EndDatePicker" Grid.Column="2" Height="24" SelectedDateChanged="Filter_Changed"/>
                            </Grid>

                            <!-- 検索条件クリアボタン -->
                            <Button Height="24" FontSize="11" Click="ClearFilterButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="検索条件をクリア" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="NewsSidebarListBox" 
                             BorderThickness="0" 
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="NewsSidebarListBox_SelectionChanged">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" 
                                        CornerRadius="6" 
                                        Padding="10" 
                                        Margin="0,0,5,8"
                                        BorderThickness="2"
                                        BorderBrush="Transparent"
                                        Background="{Binding content.kinds, Converter={StaticResource KindsToColorConverter}}">

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="ニュースIDをコピー" Click="CopyNewsId_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel>
                                        <TextBlock Text="{Binding content.title}" 
                                                   FontWeight="Bold" 
                                                   FontSize="14" 
                                                   TextWrapping="Wrap" 
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Margin="0,0,0,6"/>

                                        <Grid VerticalAlignment="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. タグ一覧 -->
                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding content.tag}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ListTagBorder" 
                                                                Background="#DDD" 
                                                                CornerRadius="3" 
                                                                Padding="4,1" 
                                                                Margin="0,0,4,4" 
                                                                Loaded="ListTagBorder_Loaded">
                                                            <TextBlock Text="{Binding}" FontSize="9" Foreground="#333"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 2. 日付エリア (縦並び) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6,0,0,0">

                                                <!-- 公開日 -->
                                                <TextBlock Text="{Binding date, StringFormat='公開日: {0}'}" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                                           TextAlignment="Left"/>

                                                <!-- 更新日 -->
                                                <TextBlock Text="{Binding updatedate, StringFormat='更新日: {0}'}" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                                           TextAlignment="Left"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding updatedate}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding updatedate}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="CardBorder" Property="Opacity" Value="0.85"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#007ACC"/>
                                        <Setter TargetName="CardBorder" Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 分け目 -->
        <GridSplitter Grid.Column="1" 
                      Width="5" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" 
                      Background="Transparent"
                      Cursor="SizeWE"/>

        <!-- 右側詳細エリア -->
        <Grid Grid.Column="2" Margin="5,0,0,0">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="全文をコピー" Click="CopyFullText_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Border x:Name="DetailHeaderBorder" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock x:Name="DetailDateTextBlock" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock x:Name="DetailTitleTextBlock" Text="左の一覧からニュースを選択してください" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="DetailTagItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#DDD" CornerRadius="3" Padding="6,2" Margin="0,0,6,6" Loaded="DetailTagBorder_Loaded">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#333"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="DetailContentPanel"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="UrlStatusBar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,10,10" Visibility="Collapsed">
                <TextBlock x:Name="UrlStatusBarText" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Border>
        </Grid>
    </Grid>
</Page>
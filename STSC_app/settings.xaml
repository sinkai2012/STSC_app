<Page x:Class="STSC_app.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings">

    <Page.Resources>
        <!-- 1. ComboBoxItem のテーマ連動スタイル -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                Padding="6,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. ComboBox 本体のテーマ連動スタイル -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot" 
                                                Background="{DynamicResource CardBackgroundBrush}" 
                                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="3">
                                            <Border x:Name="splitBorder" 
                                                    HorizontalAlignment="Right" 
                                                    Width="20">
                                                <Path x:Name="arrow" 
                                                      Data="M0,0 L4,4 L8,0 Z" 
                                                      Fill="{DynamicResource SecondaryTextBrush}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentTemplate" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,3,25,3" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" 
                                        Background="{DynamicResource CardBackgroundBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Button スタイル (色褪せ・ホバー対応) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Hyperlink スタイル -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#007ACC"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20" Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                <TextBlock Text="設定" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- 表示・テーマ -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderThickness="1">
                    <StackPanel>
                        <!-- タイトル部分：アイコンとテキストを横並び -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xF354;" 
                       FontFamily="Segoe MDL2 Assets" 
                       FontSize="16" 
                       Margin="0,0,8,0" 
                       VerticalAlignment="Center" 
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="表示・テーマ" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="テーマ切り替え" VerticalAlignment="Center" FontSize="13"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <!-- プルダウン -->
                            <ComboBox Grid.Column="1" x:Name="ThemeComboBox" Width="140" Height="26" Margin="10,0,8,0">
                                <ComboBoxItem Content="ライトモード" Tag="Light"/>
                                <ComboBoxItem Content="ダークモード" Tag="Dark"/>
                                <ComboBoxItem Content="デバイスに合わせる" Tag="System"/>
                            </ComboBox>

                            <!-- 適用ボタン（フローッピーディスク風の保存アイコン &#xE74E; ） -->
                            <Button Grid.Column="2" Width="28" Height="26" 
                    Click="ApplyThemeButton_Click" ToolTip="適用する" BorderBrush="{x:Null}" Background="{x:Null}">
                                <TextBlock Text="&#xE74E;" 
                           FontFamily="Segoe MDL2 Assets" 
                           FontSize="18" 
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- データ管理 -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
        BorderBrush="{DynamicResource CardBorderBrush}" 
        CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE74E;" 
                       FontFamily="Segoe MDL2 Assets" 
                       FontSize="16" 
                       Margin="0,0,8,0" 
                       VerticalAlignment="Center" 
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="データ管理" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,5">
                            <TextBlock Text="ニュースのキャッシュクリア" FontSize="13" Margin="0,0,0,5"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="オフラインデータや読み込みキャッシュを削除します。" FontSize="11" 
                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <Button Width="150" Height="28" HorizontalAlignment="Left" Click="ClearCacheButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="キャッシュを削除する" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- リンク -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
        BorderBrush="{DynamicResource CardBorderBrush}" 
        CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE71B;" 
                       FontFamily="Segoe MDL2 Assets" 
                       FontSize="16" 
                       Margin="0,0,8,0" 
                       VerticalAlignment="Center" 
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="リンク" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <TextBlock FontSize="13" Margin="0,3">
            <Hyperlink NavigateUri="https://sites.google.com/view/shinkai-traffic-signal/home" RequestNavigate="Hyperlink_RequestNavigate">
                公式ホームページ
            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="13" Margin="0,3">
            <Hyperlink NavigateUri="https://sites.google.com/view/shinkai-traffic-signal/Announcements_News" RequestNavigate="Hyperlink_RequestNavigate">
                公式ニュースページ
            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="13" Margin="0,3">
            <Hyperlink NavigateUri="https://sites.google.com/view/shinkai-traffic-signal/app_termsofservice" RequestNavigate="Hyperlink_RequestNavigate">
                アプリケーション利用規約
            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="13" Margin="0,3">
            <Hyperlink NavigateUri="https://sites.google.com/view/shinkai-traffic-signal/product_termsofservice" RequestNavigate="Hyperlink_RequestNavigate">
                製品利用規約
            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="13" Margin="0,3">
            <Hyperlink NavigateUri="https://sites.google.com/view/shinkai-traffic-signal/privacypolicy" RequestNavigate="Hyperlink_RequestNavigate">
                プライバシーポリシー
            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- アプリケーション情報 -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE946;" 
                               FontFamily="Segoe MDL2 Assets" 
                               FontSize="16" 
                               Margin="0,0,8,0" 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="アプリケーション情報" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <Grid Margin="0,3">
                            <TextBlock Text="制作" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="しんかい｜Gemini" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="アプリ名" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="STSC アプリ" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                        <Separator Margin="0,5"/>
                        <Grid Margin="0,3">
                            <TextBlock Text="バージョン" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="VersionTextBlock" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="公開日" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="DateTextBlock" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>

                        <Button Height="28" Margin="0,10,0,0" Click="CheckUpdateButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="アップデートを確認" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ★ ここに追加：起動時自動アップデート確認を無効化するチェックボックス -->
                        <CheckBox x:Name="DisableAutoUpdateCheckBox" 
                          Content="起動時に自動で更新を確認しない" 
                          FontSize="12" 
                          Margin="0,10,0,0" 
                          Foreground="{DynamicResource PrimaryTextBrush}" 
                          Click="DisableAutoUpdateCheckBox_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="バージョン切り替え" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <TextBlock Text="特定のバージョンを選択してインストールします" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- バージョン選択用 ComboBox -->
                            <ComboBox x:Name="VersionSelectComboBox" Grid.Column="0" Height="28" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                            <!-- 選択バージョンをインストールするボタン -->
                            <Button Grid.Column="1" Content="インストール" Width="100" Height="28" Click="InstallSelectedVersionButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
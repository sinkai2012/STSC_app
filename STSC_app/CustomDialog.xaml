<UserControl x:Class="STSC_app.CustomDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#80000000">

    <Border Background="{DynamicResource CardBackgroundBrush}" 
            BorderBrush="{DynamicResource CardBorderBrush}" 
            BorderThickness="1"
            CornerRadius="10" 
            Width="380" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.3" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="タイトル" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock x:Name="MessageText" Text="メッセージ" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="YesButton" Content="はい" Width="80" Height="30" Margin="0,0,10,0" 
                        Background="#007ACC" Foreground="White" BorderThickness="0" Click="YesButton_Click"/>
                <Button x:Name="NoButton" Content="いいえ" Width="80" Height="30" Click="NoButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
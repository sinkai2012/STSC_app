<Page x:Class="STSC_app.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STSC_app"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">

    <!-- ページ全体背景をテーマに連動 -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- 上下2段の定義 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 上段：ヘッダー -->
            <RowDefinition Height="*"/>
            <!-- 下段：メインコンテンツ -->
        </Grid.RowDefinitions>

        <!-- 1. ヘッダー（上部に固定） -->
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top" 
                    Margin="10">
            <Image Source="/しんかい信号制作株式会社.png" Height="71"/>
            <Label Content="公式アプリ" 
                   Height="71" 
                   VerticalContentAlignment="Center" 
                   FontSize="36" 
                   FontFamily="Yu Gothic UI Semibold" 
                   FontWeight="Black" 
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 2. 下段コンテンツ（左右2分割エリア） -->
        <Grid Grid.Row="1" Margin="20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
                <!-- 縦分割線用 -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側のエリア (Column="0") -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
                <StackPanel HorizontalAlignment="Stretch">
                    <Label Content="STSC アプリとは" 
                           FontSize="22" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock TextWrapping="Wrap" Margin="5,10,5,0" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}">
                            <Run Text="STSC アプリとはWindows上でSTSCの製品やニュースを閲覧することができるアプリです。" FontSize="14" />
                            <LineBreak/>
                            <Run Text="カタログタブとは" FontWeight="Bold" FontSize="18" />
                            <LineBreak/>
                            <Run Text="公式サイト「販売商品について」をアプリ内で確認することができるタブです。" FontSize="14" />
                            <LineBreak/>
                            <Run Text="（※注文することはできません。またカタログ内のページにしか移動できません）" FontSize="14" TextDecorations="Underline" />
                            <LineBreak/>
                            <Run Text="ニュースタブとは" FontWeight="Bold" FontSize="18" />
                            <LineBreak/>
                            <Run Text="アプリ内で最新のニュースを確認することができるタブです。タイトル名やタグ、投稿日での絞り込みができます。" FontSize="14" />
                            <LineBreak/>
                            <Run Text="お問い合わせタブとは" FontWeight="Bold" FontSize="18" />
                            <LineBreak/>
                            <Run Text="アプリ内でGoogle フォームを通じてお問い合わせできます。" FontSize="14" />
                        </TextBlock>
                        <Separator Margin="0,10" Height="1.5" Background="{DynamicResource CardBorderBrush}"/>
                        <Grid Margin="5,0">
                            <TextBlock TextWrapping="Wrap" FontSize="14" Text="現在のバージョン" Margin="0,0,0,10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="VersionTextBlock" TextWrapping="Wrap" Margin="5,10,5,0" FontSize="14" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                        <Grid Margin="5,0">
                            <TextBlock TextWrapping="Wrap" FontSize="14" Text="公開日" Margin="0,0,0,10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="DateTextBlock" TextWrapping="Wrap" Margin="5,10,5,0" FontSize="14" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 縦の分割線 (Column="1") -->
            <Border Grid.Column="1" 
                    Width="1.5" 
                    Background="{DynamicResource CardBorderBrush}" 
                    Margin="0,5" />

            <!-- 右側のエリア (Column="2") -->
            <Grid Grid.Column="2" Margin="15,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <!-- 右・上段 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 横分割線用 -->
                    <RowDefinition Height="1*"/>
                    <!-- 右・下段 -->
                </Grid.RowDefinitions>

                <!-- 右・上段のコンテンツ -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Label x:Name="ReleaseNotes" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <RichTextBox Margin="5,10,5,0" 
                                     IsReadOnly="True" 
                                     BorderThickness="0" 
                                     Background="Transparent" 
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     FontSize="14">
                            <FlowDocument>
                                <List MarkerStyle="Disc">
                                    <ListItem>
                                        <Paragraph>なし</Paragraph>
                                    </ListItem>
                                </List>
                            </FlowDocument>
                        </RichTextBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右側の横分割線 -->
                <Border Grid.Row="1" 
                        Height="1.5" 
                        Background="{DynamicResource CardBorderBrush}" 
                        Margin="5,0" />

                <!-- 右・下段のコンテンツ -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Label Content="今後追加予定" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <RichTextBox Margin="5,10,5,0" 
                                     IsReadOnly="True" 
                                     BorderThickness="0" 
                                     Background="Transparent" 
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     FontSize="14">
                            <FlowDocument>
                                <List MarkerStyle="Disc">
                                    <ListItem>
                                        <Paragraph>アプリ内から直接注文</Paragraph>
                                    </ListItem>
                                    <ListItem>
                                        <Paragraph>アカウントログイン</Paragraph>
                                    </ListItem>
                                </List>
                            </FlowDocument>
                        </RichTextBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
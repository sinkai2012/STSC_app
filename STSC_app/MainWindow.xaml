<Window x:Class="STSC_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STSC アプリ" Height="600" Width="900" MinHeight="450" MinWidth="800">

    <Window.Resources>
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border x:Name="border" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Button Height="50" Margin="5" Click="HomeButton_Click" Cursor="Hand" BorderThickness="0" Width="50" ToolTip="ホームに戻る">
                    <Button.Background>
                        <ImageBrush ImageSource="/STSC_HOME.png"/>
                    </Button.Background>
                </Button>
                
                <Button Height="50" Margin="5" Click="CatalogButton_Click" Cursor="Hand" BorderThickness="0" Width="50" ToolTip="製品を見る">
                    <Button.Background>
                        <ImageBrush ImageSource="/STSC_CATALOG.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
                
                <Button Height="50" Margin="5" Click="NewsButton_Click" Cursor="Hand" BorderThickness="0" Width="50" ToolTip="ニュースを見る">
                    <Button.Background>
                        <ImageBrush ImageSource="/STSC_NEWS.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <Button Height="50" Margin="5" Click="ContactButton_Click" Cursor="Hand" BorderThickness="0" Width="50" ToolTip="お問い合わせ">
                    <Button.Background>
                        <ImageBrush ImageSource="/STSC_INQUIRY.png"/>
                    </Button.Background>
                </Button>
                <Button Content="設定" Height="40" Margin="5" Click="SettingsButton_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
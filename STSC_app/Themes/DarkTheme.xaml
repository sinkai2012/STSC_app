<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ダークモード用のカラー定義 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAAAAA"/>
</ResourceDictionary>